# Copy to .env and export before running (e.g. `set -a; . ./.env; set +a`).
# Everything is optional; defaults shown.

# Chrome DevTools endpoint of the dedicated, logged-in Chrome (bind it to localhost only)
LBC_CDP_URL=http://127.0.0.1:9222
# Chrome --user-data-dir for the dedicated profile (documentation only; scripts do not read it)
LBC_CHROME_PROFILE=$HOME/.config/leboncoin-chrome

# Working directories (default: repository root, <root>/state, <root>/tmp)
#LBC_HOME=/path/to/lbc-agent
#LBC_STATE_DIR=/path/to/lbc-agent/state
#LBC_TMP=/path/to/lbc-agent/tmp
#LBC_BROWSER_LOCK=/path/to/lbc-agent/state/browser.lock

# Optional residential egress check for the weekly collector
#LBC_PROXY=http://127.0.0.1:3128
#LBC_EXPECTED_EGRESS=203.0.113.10

#LBC_TZ=Europe/Paris
#LBC_KEEP_TABS=1
#PYTHON=python3

# Optional Hermes Kanban integration (integrations/hermes/enqueue_listing.py)
#LBC_KANBAN_BOARD=leboncoin
#LBC_INTAKE_PROFILES=intake-1,intake-2,intake-3
#LBC_PUBLISHER_PROFILE=publisher
#LBC_VERIFIER_PROFILE=verifier
#LBC_EXPERT_PROFILE=expert
#LBC_MODEL=
#LBC_PROVIDER=
#LBC_EXPERT_MODEL=
#LBC_EXPERT_PROVIDER=
#LBC_NOTIFY_PLATFORM=telegram
#LBC_NOTIFY_CHAT_ID=<your-alert-channel>
#LBC_NOTIFY_THREAD_ID=
#LBC_NOTIFY_USER_ID=
